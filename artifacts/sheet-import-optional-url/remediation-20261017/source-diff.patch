+  return (
+    keys.length === Object.keys(base).length &&
+    keys.every(
+      (key) =>
+        Object.prototype.hasOwnProperty.call(base, key) &&
+        eventUpdateValueMatches(
+          (current as Record<string, unknown>)[key],
+          (base as Record<string, unknown>)[key],
+        ),
+    )
+  );
